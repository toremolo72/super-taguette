#: taguette/main.py:271
msgid "Don't open the web browser"
msgstr "Webブラウザを開かない"

#: taguette/main.py:276
#, python-format
msgid "Database location or connection string, for example 'project.db' or 'postgresql://me:pw@localhost/mydb' (default: %(default)r)"
msgstr "データベースの場所または接続文字列。例: 'project.db' または 'postgresql://me:pw@localhost/mydb'（デフォルト: %(default)r）"

#: taguette/main.py:283
msgid "Set the file creation mask (umask) on systems that support it."
msgstr "対応しているシステムでファイル作成マスク（umask）を設定する。"

#: taguette/main.py:287
msgid "Don't change umask on startup"
msgstr "起動時にumaskを変更しない"

#: taguette/main.py:293
msgid "additional commands"
msgstr "追加コマンド"

#: taguette/main.py:297
msgid "Manually trigger a database migration"
msgstr "データベースのマイグレーションを手動で実行する"

